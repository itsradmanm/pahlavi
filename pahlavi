#!/usr/bin/env bash

# ==============================================================================
# PAHLAVI CLI - MANAGEMENT TOOL (MARZBAN & 3X-UI STYLE)
# ابزار خط فرمان مدیریت جامع پنل پهلوی
# ==============================================================================

APP_DIR="/opt/pahlavy"
ENV_FILE="$APP_DIR/backend/.env"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

show_banner() {
  echo -e "${CYAN}${BOLD}"
  echo "=================================================="
  echo "            🦁 Pahlavi Panel CLI (3X-UI) 🦁       "
  echo "=================================================="
  echo -e "${NC}"
}

show_help() {
  show_banner
  echo -e "${BOLD}Usage:${NC}"
  echo -e "  pahlavi [command]\n"
  echo -e "${BOLD}Commands:${NC}"
  echo -e "  ${GREEN}up / start${NC}       – Start Pahlavi, PostgreSQL & Xray services"
  echo -e "  ${RED}down / stop${NC}      – Stop Pahlavi panel service"
  echo -e "  ${YELLOW}restart${NC}          – Restart all Pahlavi services"
  echo -e "  ${CYAN}status${NC}           – Show status of Panel, Xray-core, Database & SSL"
  echo -e "  ${CYAN}logs${NC}             – Show live streaming logs of Pahlavi panel"
  echo -e "  ${YELLOW}admin${NC}            – Reset or update Admin username & password"
  echo -e "  ${YELLOW}port${NC}             – Change Panel web port"
  echo -e "  ${YELLOW}cert${NC}             – Interactive SSL manager (Let's Encrypt / Self-Signed)"
  echo -e "  ${GREEN}ssl-on${NC}           – Enable HTTPS web panel mode"
  echo -e "  ${RED}ssl-off${NC}          – Disable SSL and switch back to HTTP mode"
  echo -e "  ${BLUE}core-update${NC}      – Update Xray-core to latest release"
  echo -e "  ${BLUE}backup${NC}           – Create complete backup of DB & configs"
  echo -e "  ${BLUE}restore${NC}          – Restore panel database from backup"
  echo -e "  ${BLUE}edit-env${NC}         – Edit environment file (.env) via nano"
  echo -e "  ${RED}uninstall${NC}        – Completely uninstall Pahlavi panel"
  echo -e "  ${CYAN}help${NC}             – Show this help message\n"
  echo -e "${BOLD}Directories:${NC}"
  echo -e "  App directory: ${YELLOW}$APP_DIR${NC}"
  echo -e "=================================================="
}

cmd_start() {
  echo -e "${YELLOW}Starting Pahlavi services...${NC}"
  systemctl start postgresql 2>/dev/null || true
  systemctl start xray 2>/dev/null || true
  systemctl start pahlavy 2>/dev/null || true
  echo -e "${GREEN}✓ All services started successfully.${NC}"
}

cmd_stop() {
  echo -e "${YELLOW}Stopping Pahlavi panel...${NC}"
  systemctl stop pahlavy 2>/dev/null || true
  echo -e "${RED}✓ Pahlavi panel stopped.${NC}"
}

cmd_restart() {
  echo -e "${YELLOW}Restarting Pahlavi, PostgreSQL & Xray services...${NC}"
  systemctl restart postgresql 2>/dev/null || true
  systemctl restart xray 2>/dev/null || true
  systemctl restart pahlavy 2>/dev/null || true
  echo -e "${GREEN}✓ Services restarted successfully.${NC}"
}

cmd_status() {
  show_banner
  echo -e "${BOLD}--- Service Status ---${NC}"
  
  if systemctl is-active --quiet pahlavy 2>/dev/null; then
    echo -e "  Pahlavi Panel: ${GREEN}● RUNNING${NC}"
  else
    echo -e "  Pahlavi Panel: ${RED}● STOPPED${NC}"
  fi

  if systemctl is-active --quiet xray 2>/dev/null; then
    echo -e "  Xray-core:     ${GREEN}● RUNNING${NC}"
  else
    echo -e "  Xray-core:     ${RED}● STOPPED${NC}"
  fi

  if systemctl is-active --quiet postgresql 2>/dev/null; then
    echo -e "  PostgreSQL DB: ${GREEN}● RUNNING${NC}"
  else
    echo -e "  PostgreSQL DB: ${RED}● STOPPED${NC}"
  fi

  if [ -f "$ENV_FILE" ]; then
    PORT=$(grep "^PORT=" "$ENV_FILE" | cut -d '=' -f2)
    HOST=$(grep "^TLS_DOMAIN=" "$ENV_FILE" | cut -d '=' -f2)
    HOST=${HOST:-$(curl -s4 ifconfig.me || echo "localhost")}
    ENABLE_SSL=$(grep "^ENABLE_SSL=" "$ENV_FILE" | cut -d '=' -f2)
    
    if [ "$ENABLE_SSL" = "true" ] || [ -f "/etc/pahlavy/certs/active/fullchain.pem" ]; then
      SSL_STATUS="${GREEN}● ENABLED (HTTPS)${NC}"
      URL="https://$HOST:$PORT"
    else
      SSL_STATUS="${YELLOW}● DISABLED (HTTP)${NC}"
      URL="http://$HOST:$PORT"
    fi

    echo -e "\n${BOLD}--- Access Info ---${NC}"
    echo -e "  SSL Status:    $SSL_STATUS"
    echo -e "  Web Panel URL: ${CYAN}${BOLD}$URL${NC} (Port: ${YELLOW}$PORT${NC})"
  fi
  echo -e "=================================================="
}

cmd_logs() {
  echo -e "${CYAN}Streaming live logs of Pahlavi Panel (Press Ctrl+C to exit)...${NC}"
  journalctl -u pahlavy -f -n 50
}

cmd_admin() {
  echo -e "${BOLD}--- Reset Admin Credentials ---${NC}"
  read -p "Enter new admin username [admin]: " NEW_USER
  NEW_USER=${NEW_USER:-admin}
  read -p "Enter new admin password: " NEW_PASS

  if [ -z "$NEW_PASS" ]; then
    echo -e "${RED}Password cannot be empty.${NC}"
    exit 1
  fi

  cd "$APP_DIR/backend"
  node -e "
    require('dotenv').config();
    const bcrypt = require('bcryptjs');
    const { query } = require('./database');
    async function reset() {
      const hash = await bcrypt.hash('$NEW_PASS', 12);
      await query('UPDATE users SET username = \$1, password = \$2, is_active = true WHERE role = \'admin\'', ['$NEW_USER', hash]);
      console.log('✓ Admin account updated: $NEW_USER / $NEW_PASS');
      process.exit(0);
    }
    reset().catch(e => { console.error(e); process.exit(1); });
  "
  echo -e "${GREEN}✓ Admin credentials updated successfully.${NC}"
}

cmd_port() {
  echo -e "${BOLD}--- Change Panel Web Port ---${NC}"
  read -p "Enter new panel port (e.g. 3000, 8080, 2053, 54321): " NEW_PORT
  if [ -z "$NEW_PORT" ] || ! [[ "$NEW_PORT" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}Invalid port number.${NC}"
    exit 1
  fi

  sed -i "s/^PORT=.*/PORT=$NEW_PORT/" "$ENV_FILE"
  if command -v ufw &>/dev/null; then
    ufw allow "$NEW_PORT"/tcp 2>/dev/null || true
  fi
  if command -v iptables &>/dev/null; then
    iptables -I INPUT -p tcp --dport "$NEW_PORT" -j ACCEPT 2>/dev/null || true
  fi
  systemctl restart pahlavy
  echo -e "${GREEN}✓ Port changed to $NEW_PORT. Panel service restarted.${NC}"
}

cmd_core_update() {
  echo -e "${YELLOW}Updating Xray-core to latest release...${NC}"
  bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
  systemctl restart xray
  echo -e "${GREEN}✓ Xray-core updated and restarted.${NC}"
}

cmd_edit_env() {
  if command -v nano &>/dev/null; then
    nano "$ENV_FILE"
  elif command -v vi &>/dev/null; then
    vi "$ENV_FILE"
  else
    echo -e "${RED}Neither nano nor vi found.${NC}"
  fi
  systemctl restart pahlavy
}

cmd_cert() {
  echo -e "${BOLD}--- SSL Certificate Management ---${NC}"
  echo "1) Issue / Renew Let's Encrypt SSL (Zero-Email, Automatic on Port 80)"
  echo "2) Generate Self-Signed SSL Certificate (Instant, works without DNS)"
  echo "3) Disable SSL (Switch back to plain HTTP)"
  read -p "Select option [1-3]: " CERT_OPT

  case "$CERT_OPT" in
    1)
      read -p "Enter domain name (e.g. vpn.example.com): " DOMAIN
      if [ -z "$DOMAIN" ]; then
        echo -e "${RED}Domain cannot be empty.${NC}"
        return
      fi
      systemctl stop nginx 2>/dev/null || true
      systemctl stop apache2 2>/dev/null || true
      certbot certonly --standalone --non-interactive --agree-tos --register-unsafely-without-email -d "$DOMAIN"

      if [ -f "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ]; then
        mkdir -p /etc/pahlavy/certs/active /etc/pahlavy/certs/"$DOMAIN"
        cp -f "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" /etc/pahlavy/certs/active/fullchain.pem
        cp -f "/etc/letsencrypt/live/$DOMAIN/privkey.pem" /etc/pahlavy/certs/active/privkey.pem
        cp -f "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" "/etc/pahlavy/certs/$DOMAIN/fullchain.pem"
        cp -f "/etc/letsencrypt/live/$DOMAIN/privkey.pem" "/etc/pahlavy/certs/$DOMAIN/privkey.pem"
        sed -i "s/^ENABLE_SSL=.*/ENABLE_SSL=true/" "$ENV_FILE" 2>/dev/null || echo "ENABLE_SSL=true" >> "$ENV_FILE"
        sed -i "s/^TLS_DOMAIN=.*/TLS_DOMAIN=$DOMAIN/" "$ENV_FILE" 2>/dev/null || echo "TLS_DOMAIN=$DOMAIN" >> "$ENV_FILE"
        systemctl restart pahlavy
        echo -e "${GREEN}✓ Let's Encrypt SSL certificate applied! Panel restarted with HTTPS.${NC}"
      else
        echo -e "${YELLOW}Let's Encrypt standalone verification did not succeed on port 80.${NC}"
        echo -e "${CYAN}→ Auto-generating Self-Signed SSL fallback so HTTPS works immediately...${NC}"
        mkdir -p /etc/pahlavy/certs/active /etc/pahlavy/certs/"$DOMAIN"
        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
          -keyout /etc/pahlavy/certs/active/privkey.pem \
          -out /etc/pahlavy/certs/active/fullchain.pem \
          -subj "/C=US/ST=State/L=City/O=Pahlavy/CN=$DOMAIN" 2>/dev/null || true
        cp -f /etc/pahlavy/certs/active/privkey.pem "/etc/pahlavy/certs/$DOMAIN/privkey.pem" 2>/dev/null || true
        cp -f /etc/pahlavy/certs/active/fullchain.pem "/etc/pahlavy/certs/$DOMAIN/fullchain.pem" 2>/dev/null || true
        sed -i "s/^ENABLE_SSL=.*/ENABLE_SSL=true/" "$ENV_FILE" 2>/dev/null || echo "ENABLE_SSL=true" >> "$ENV_FILE"
        sed -i "s/^TLS_DOMAIN=.*/TLS_DOMAIN=$DOMAIN/" "$ENV_FILE" 2>/dev/null || echo "TLS_DOMAIN=$DOMAIN" >> "$ENV_FILE"
        systemctl restart pahlavy
        echo -e "${GREEN}✓ Self-Signed SSL certificate active! Panel restarted with HTTPS.${NC}"
      fi
      ;;
    2)
      read -p "Enter domain name or server IP: " DOMAIN
      DOMAIN=${DOMAIN:-$(curl -s4 ifconfig.me || echo "localhost")}
      mkdir -p /etc/pahlavy/certs/active /etc/pahlavy/certs/"$DOMAIN"
      openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout /etc/pahlavy/certs/active/privkey.pem \
        -out /etc/pahlavy/certs/active/fullchain.pem \
        -subj "/C=US/ST=State/L=City/O=Pahlavy/CN=$DOMAIN"
      cp -f /etc/pahlavy/certs/active/privkey.pem "/etc/pahlavy/certs/$DOMAIN/privkey.pem" 2>/dev/null || true
      cp -f /etc/pahlavy/certs/active/fullchain.pem "/etc/pahlavy/certs/$DOMAIN/fullchain.pem" 2>/dev/null || true
      sed -i "s/^ENABLE_SSL=.*/ENABLE_SSL=true/" "$ENV_FILE" 2>/dev/null || echo "ENABLE_SSL=true" >> "$ENV_FILE"
      sed -i "s/^TLS_DOMAIN=.*/TLS_DOMAIN=$DOMAIN/" "$ENV_FILE" 2>/dev/null || echo "TLS_DOMAIN=$DOMAIN" >> "$ENV_FILE"
      systemctl restart pahlavy
      echo -e "${GREEN}✓ Self-Signed SSL certificate generated and applied! Panel restarted with HTTPS.${NC}"
      ;;
    3)
      sed -i "s/^ENABLE_SSL=.*/ENABLE_SSL=false/" "$ENV_FILE" 2>/dev/null || echo "ENABLE_SSL=false" >> "$ENV_FILE"
      rm -f /etc/pahlavy/certs/active/fullchain.pem /etc/pahlavy/certs/active/privkey.pem
      systemctl restart pahlavy
      echo -e "${YELLOW}✓ SSL disabled. Panel restarted in HTTP mode.${NC}"
      ;;
    *)
      echo -e "${RED}Invalid choice.${NC}"
      ;;
  esac
}

cmd_ssl_on() {
  sed -i "s/^ENABLE_SSL=.*/ENABLE_SSL=true/" "$ENV_FILE" 2>/dev/null || echo "ENABLE_SSL=true" >> "$ENV_FILE"
  systemctl restart pahlavy
  echo -e "${GREEN}✓ SSL enabled on Pahlavi panel.${NC}"
}

cmd_ssl_off() {
  sed -i "s/^ENABLE_SSL=.*/ENABLE_SSL=false/" "$ENV_FILE" 2>/dev/null || echo "ENABLE_SSL=false" >> "$ENV_FILE"
  systemctl restart pahlavy
  echo -e "${YELLOW}✓ SSL disabled. Panel running in HTTP mode.${NC}"
}

cmd_backup() {
  echo -e "${YELLOW}Creating backup of Pahlavi panel & database...${NC}"
  BACKUP_DIR="/opt/pahlavy_backups"
  mkdir -p "$BACKUP_DIR"
  BACKUP_FILE="$BACKUP_DIR/pahlavy_backup_$(date +%Y%m%d_%H%M%S).tar.gz"

  sudo -u postgres pg_dump pahlavy > /tmp/pahlavy_db.sql 2>/dev/null || true
  tar -czf "$BACKUP_FILE" -C /tmp pahlavy_db.sql -C "$APP_DIR/backend" .env 2>/dev/null || true
  rm -f /tmp/pahlavy_db.sql

  echo -e "${GREEN}✓ Backup created successfully at:${NC} ${CYAN}$BACKUP_FILE${NC}"
}

cmd_restore() {
  echo -e "${BOLD}--- Restore Database from Backup ---${NC}"
  read -p "Enter path to backup archive (.tar.gz): " BACKUP_PATH
  if [ ! -f "$BACKUP_PATH" ]; then
    echo -e "${RED}Backup file not found: $BACKUP_PATH${NC}"
    exit 1
  fi

  tar -xzf "$BACKUP_PATH" -C /tmp
  if [ -f /tmp/pahlavy_db.sql ]; then
    sudo -u postgres psql pahlavy < /tmp/pahlavy_db.sql
    rm -f /tmp/pahlavy_db.sql
    systemctl restart pahlavy
    echo -e "${GREEN}✓ Database restored successfully!${NC}"
  else
    echo -e "${RED}Invalid backup archive.${NC}"
  fi
}

cmd_uninstall() {
  if [ -f "$APP_DIR/uninstall.sh" ]; then
    bash "$APP_DIR/uninstall.sh"
  elif [ -f "./uninstall.sh" ]; then
    bash "./uninstall.sh"
  else
    echo -e "${RED}Uninstall script not found.${NC}"
  fi
}

interactive_menu() {
  while true; do
    show_banner
    echo -e "${BOLD}--- Pahlavi Panel Management Menu ---${NC}"
    echo -e "  ${GREEN}1)${NC}  Start Services"
    echo -e "  ${RED}2)${NC}  Stop Services"
    echo -e "  ${YELLOW}3)${NC}  Restart Services"
    echo -e "  ${CYAN}4)${NC}  Service Status & Access URL"
    echo -e "  ${CYAN}5)${NC}  Live Streaming Logs"
    echo -e "  ${YELLOW}6)${NC}  Reset Admin Credentials"
    echo -e "  ${YELLOW}7)${NC}  Change Web Panel Port"
    echo -e "  ${YELLOW}8)${NC}  SSL Management (Zero-Email Let's Encrypt / Self-Signed)"
    echo -e "  ${GREEN}9)${NC}  Enable HTTPS Mode"
    echo -e "  ${RED}10)${NC} Disable SSL (HTTP Mode)"
    echo -e "  ${BLUE}11)${NC} Update Xray-core"
    echo -e "  ${BLUE}12)${NC} Backup Database & Configs"
    echo -e "  ${BLUE}13)${NC} Restore Database"
    echo -e "  ${BLUE}14)${NC} Edit .env Configuration"
    echo -e "  ${RED}15)${NC} Uninstall Panel"
    echo -e "  ${PURPLE}0)${NC}  Exit"
    echo "=================================================="
    read -p "Please select an option [0-15]: " choice
    case "$choice" in
      1) cmd_start ;;
      2) cmd_stop ;;
      3) cmd_restart ;;
      4) cmd_status ;;
      5) cmd_logs ;;
      6) cmd_admin ;;
      7) cmd_port ;;
      8) cmd_cert ;;
      9) cmd_ssl_on ;;
      10) cmd_ssl_off ;;
      11) cmd_core_update ;;
      12) cmd_backup ;;
      13) cmd_restore ;;
      14) cmd_edit_env ;;
      15) cmd_uninstall; break ;;
      0) echo "Goodbye!"; exit 0 ;;
      *) echo -e "${RED}Invalid selection.${NC}" ;;
    esac
    echo ""
    read -p "Press Enter to return to menu..."
  done
}

# Command Switcher
case "$1" in
  up|start)
    cmd_start
    ;;
  down|stop)
    cmd_stop
    ;;
  restart)
    cmd_restart
    ;;
  status)
    cmd_status
    ;;
  logs)
    cmd_logs
    ;;
  admin)
    cmd_admin
    ;;
  port)
    cmd_port
    ;;
  core-update)
    cmd_core_update
    ;;
  backup)
    cmd_backup
    ;;
  restore)
    cmd_restore
    ;;
  edit-env)
    cmd_edit_env
    ;;
  cert)
    cmd_cert
    ;;
  ssl-on)
    cmd_ssl_on
    ;;
  ssl-off)
    cmd_ssl_off
    ;;
  uninstall)
    cmd_uninstall
    ;;
  help|--help|-h)
    show_help
    ;;
  "")
    interactive_menu
    ;;
  *)
    echo -e "${RED}Unknown command: $1${NC}"
    show_help
    exit 1
    ;;
esac
